# ─── API ────────────────────────────────────────────
# En desarrollo se usa el proxy de Vite (/api -> localhost:8000).
# En producción el proxy de vercel.json sirve /api desde el mismo origen.
VITE_API_URL=/api/v1

# ─── App ────────────────────────────────────────────
VITE_APP_NAME=Together

# ─── Google OAuth ──────────────────────────────────
VITE_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
